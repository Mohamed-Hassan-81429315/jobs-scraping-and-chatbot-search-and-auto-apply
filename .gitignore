cat >> .gitignore <<'EOF'

# Environment variables and secrets
.env
.env.*
!.env.example

# Python
venv/
.venv/
__pycache__/
*.py[cod]

# IDE
.vscode/

# Logs
*.log

# Node.js
node_modules/

# Build files
dist/
build/
EOFjobs.json

# Scraping data
jobs.json
jobs.json.tmp
*.log

# Python
__pycache__/
*.py[cod]
venv/
.env
