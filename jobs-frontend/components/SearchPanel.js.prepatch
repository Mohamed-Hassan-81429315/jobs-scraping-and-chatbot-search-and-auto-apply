'use client';

import { Fragment, useEffect, useId, useMemo, useRef, useState, useTransition } from 'react';
import { useRouter } from 'next/navigation';
import { fetchSuggestions } from '../lib/api';
import { buildHref } from '../lib/params';
import { TRENDING } from '../lib/trending';

const RECENT_KEY = 'jobscope:recent';
const EMPTY = { titles: [], companies: [], locations: [] };

function loadRecent() {
  try {
    return JSON.parse(localStorage.getItem(RECENT_KEY) || '[]').slice(0, 5);
  } catch {
    return [];
  }
}

function saveRecent(term) {
  try {
    const next = [term, ...loadRecent().filter((t) => t.toLowerCase() !== term.toLowerCase())].slice(0, 5);
    localStorage.setItem(RECENT_KEY, JSON.stringify(next));
  } catch {}
}

function clearRecent() {
  try {
    localStorage.removeItem(RECENT_KEY);
  } catch {}
}

function Highlight({ text, term }) {
  const words = term.trim().split(/\s+/).filter(Boolean).map((w) => w.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'));
  if (!words.length) return text;
  const parts = text.split(new RegExp(`(${words.join('|')})`, 'ig'));
  return parts.map((part, i) => (i % 2 ? <mark key={i}>{part}</mark> : part));
}

function Icon({ name }) {
  const shapes = {
    search: <><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></>,
    building: <><path d="M4 21V5a1 1 0 0 1 1-1h8a1 1 0 0 1 1 1v16" /><path d="M14 9h5a1 1 0 0 1 1 1v11" /><path d="M8 8h2M8 12h2M8 16h2" /></>,
    pin: <><path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11Z" /><circle cx="12" cy="10" r="2.5" /></>,
    clock: <><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></>,
    trend: <path d="m3 17 6-6 4 4 8-8M15 7h6v6" />,
  };
  return (
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.8" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
      {shapes[name]}
    </svg>
  );
}

export default function SearchPanel({ params }) {
  const router = useRouter();
  const [isPending, startTransition] = useTransition();
  const listId = useId();
  const formRef = useRef(null);
  const inputRef = useRef(null);

  const [value, setValue] = useState(params.q);
  const [open, setOpen] = useState(false);
  const [active, setActive] = useState(-1);
  const [data, setData] = useState(EMPTY);
  const [recent, setRecent] = useState([]);

  // Keep the box in sync with the URL (back/forward, removing a chip).
  useEffect(() => { setValue(params.q); }, [params.q]);
  useEffect(() => { setRecent(loadRecent()); }, []);

  // Close when clicking outside.
  useEffect(() => {
    const onDown = (e) => {
      if (formRef.current && !formRef.current.contains(e.target)) setOpen(false);
    };
    document.addEventListener('pointerdown', onDown);
    return () => document.removeEventListener('pointerdown', onDown);
  }, []);

  // Debounced suggestions.
  const term = value.trim();
  useEffect(() => {
    if (term.length < 2) {
      setData(EMPTY);
      return;
    }
    const ctrl = new AbortController();
    const timer = setTimeout(async () => {
      try {
        setData(await fetchSuggestions(term, ctrl.signal));
        setActive(-1);
      } catch {}
    }, 160);
    return () => {
      clearTimeout(timer);
      ctrl.abort();
    };
  }, [term]);

  const items = useMemo(() => {
    if (term.length >= 2) {
      return [
        ...data.titles.map((label) => ({ type: 'query', icon: 'search', label, group: 'Jobs' })),
        ...data.companies.map((label) => ({ type: 'company', icon: 'building', label, group: 'Companies' })),
        ...data.locations.map((label) => ({ type: 'location', icon: 'pin', label, group: 'Locations' })),
      ];
    }
    return [
      ...recent.map((label) => ({ type: 'query', icon: 'clock', label, group: 'Recent searches' })),
      ...TRENDING.slice(0, 6).map((label) => ({ type: 'query', icon: 'trend', label, group: 'Trending' })),
    ];
  }, [term, data, recent]);

  const expanded = open && items.length > 0;

  function navigate(overrides) {
    setOpen(false);
    setActive(-1);
    startTransition(() => router.push(buildHref(params, overrides)));
  }

  function choose(item) {
    if (item.type === 'company') {
      setValue('');
      navigate({ q: '', company: item.label });
    } else if (item.type === 'location') {
      setValue('');
      navigate({ q: '', location: item.label });
    } else {
      setValue(item.label);
      saveRecent(item.label);
      setRecent(loadRecent());
      navigate({ q: item.label });
    }
  }

  function onSubmit(e) {
    e.preventDefault();
    if (active >= 0 && items[active]) {
      choose(items[active]);
      return;
    }
    const q = value.trim();
    if (q) {
      saveRecent(q);
      setRecent(loadRecent());
    }
    navigate({ q });
  }

  function onKeyDown(e) {
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      if (!open) setOpen(true);
      setActive((a) => (items.length ? (a + 1) % items.length : -1));
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      setActive((a) => (items.length ? (a <= 0 ? items.length - 1 : a - 1) : -1));
    } else if (e.key === 'Escape') {
      setOpen(false);
      setActive(-1);
    } else if (e.key === 'Tab') {
      setOpen(false);
    }
  }

  const hasRecent = term.length < 2 && recent.length > 0;

  return (
    <form ref={formRef} role="search" className="searchbar" onSubmit={onSubmit} aria-busy={isPending}>
      <div className="field">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.8" strokeLinecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7" />
          <path d="m20 20-3.5-3.5" />
        </svg>
        <input
          ref={inputRef}
          type="text"
          role="combobox"
          aria-label="Search jobs by title, company or location"
          aria-autocomplete="list"
          aria-expanded={expanded}
          aria-controls={`${listId}-list`}
          aria-activedescendant={active >= 0 ? `${listId}-opt-${active}` : undefined}
          placeholder="Job title, company or location"
          autoComplete="off"
          spellCheck={false}
          enterKeyHint="search"
          maxLength={100}
          value={value}
          onChange={(e) => {
            setValue(e.target.value);
            setOpen(true);
            setActive(-1);
          }}
          onFocus={() => setOpen(true)}
          onKeyDown={onKeyDown}
        />
        {value && (
          <button
            type="button"
            className="clear"
            aria-label="Clear search text"
            onClick={() => {
              setValue('');
              setOpen(true);
              inputRef.current?.focus();
            }}
          >
            ×
          </button>
        )}
      </div>

      <button type="submit" className="go" disabled={isPending}>
        {isPending ? <><span className="spinner" aria-hidden="true" /><span className="sr">Searching</span></> : 'Search'}
      </button>

      {expanded && (
        <div className="suggest">
          <ul id={`${listId}-list`} role="listbox" aria-label="Search suggestions">
            {items.map((it, i) => (
              <Fragment key={`${it.group}-${it.label}`}>
                {(i === 0 || items[i - 1].group !== it.group) && (
                  <li role="presentation" className="sg-group">{it.group}</li>
                )}
                <li
                  id={`${listId}-opt-${i}`}
                  role="option"
                  aria-selected={i === active}
                  className="sg-item"
                  onPointerDown={(e) => {
                    e.preventDefault();
                    choose(it);
                  }}
                  onMouseEnter={() => setActive(i)}
                >
                  <Icon name={it.icon} />
                  <span><Highlight text={it.label} term={term.length >= 2 ? term : ''} /></span>
                </li>
              </Fragment>
            ))}
          </ul>
          {hasRecent && (
            <div className="sg-foot">
              <button
                type="button"
                onPointerDown={(e) => {
                  e.preventDefault();
                  clearRecent();
                  setRecent([]);
                }}
              >
                Clear recent searches
              </button>
            </div>
          )}
        </div>
      )}
    </form>
  );
}
