'use client';

import { useEffect, useState } from 'react';

async function copyText(text) {
  try {
    await navigator.clipboard.writeText(text);
    return true;
  } catch {
    try {
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.setAttribute('readonly', '');
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      const ok = document.execCommand('copy');
      document.body.removeChild(ta);
      return ok;
    } catch {
      return false;
    }
  }
}

export default function CopyCodeButton({ code }) {
  const [copied, setCopied] = useState(false);

  // Browsers may refuse an automatic copy without a click; the button below covers that.
  useEffect(() => {
    let alive = true;
    copyText(code).then((ok) => { if (alive && ok) setCopied(true); });
    return () => { alive = false; };
  }, [code]);

  async function onClick() {
    if (await copyText(code)) setCopied(true);
  }

  return (
    <button
      type="button"
      className="btn-ghost"
      onClick={onClick}
      aria-live="polite"
      style={{ width: '100%', marginTop: 12 }}
    >
      {copied ? 'Code copied ✓' : 'Copy OTP code'}
    </button>
  );
}
