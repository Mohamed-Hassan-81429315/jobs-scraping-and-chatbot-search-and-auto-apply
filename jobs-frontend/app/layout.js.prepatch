import './globals.css';
import Link from 'next/link';
import { Inter, Space_Grotesk } from 'next/font/google';

const body = Inter({ subsets: ['latin'], variable: '--font-body', display: 'swap' });
const display = Space_Grotesk({ subsets: ['latin'], variable: '--font-display', display: 'swap' });

const SITE_URL = process.env.NEXT_PUBLIC_SITE_URL || 'http://localhost:3000';
const DESCRIPTION =
  'JobScope searches job openings collected from many platforms in one place. Filter by location, company, remote and date, then apply on the original site.';

export const metadata = {
  metadataBase: new URL(SITE_URL),
  title: {
    default: 'JobScope: search jobs from every platform in one place',
    template: '%s | JobScope',
  },
  description: DESCRIPTION,
  applicationName: 'JobScope',
  openGraph: {
    type: 'website',
    siteName: 'JobScope',
    title: 'JobScope: search jobs from every platform in one place',
    description: DESCRIPTION,
    url: '/',
  },
  twitter: { card: 'summary_large_image' },
  robots: { index: true, follow: true },
};

export const viewport = { themeColor: '#080c1a', colorScheme: 'dark' };

export default function RootLayout({ children }) {
  return (
    <html lang="en">
      <body className={`${body.variable} ${display.variable}`}>
        <a className="skip" href="#results">Skip to results</a>

        <header className="site-header">
          <div className="wrap">
            <Link href="/" className="brand" aria-label="JobScope home">
              <span className="brand-mark" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.6" strokeLinecap="round">
                  <circle cx="11" cy="11" r="6" />
                  <path d="m20 20-4-4" />
                </svg>
              </span>
              JobScope
            </Link>
            <nav className="nav" aria-label="Main">
              <Link href="/?remote=1" prefetch={false}>Remote jobs</Link>
              <Link href="/?posted=24h" prefetch={false}>New today</Link>
            </nav>
          </div>
        </header>

        {children}

        <footer className="site-footer">
          <div className="wrap">
            <p>© {new Date().getFullYear()} JobScope. Listings are collected from public sources; you apply on the original site.</p>
          </div>
        </footer>
      </body>
    </html>
  );
}
