index 2f5e684..2d766f7 100644
--- a/jobs-backend/app/Mail/PasswordOtpMail.php
+++ b/jobs-backend/app/Mail/PasswordOtpMail.php
@@ -13,8 +13,12 @@ class PasswordOtpMail extends Mailable
     use Queueable, SerializesModels;
 
     // Not queued on purpose: the code must not be written into a jobs table.
-    public function __construct(public string $code, public int $minutes, public string $name)
-    {
+    public function __construct(
+        public string $code,
+        public int $minutes,
+        public string $name,
+        public ?string $email = null,
+    ) {
     }
 
     public function envelope(): Envelope
@@ -24,6 +28,25 @@ public function envelope(): Envelope
 
     public function content(): Content
     {
-        return new Content(view: 'emails.password-otp', text: 'emails.password-otp-text');
+        return new Content(
+            view: 'emails.password-otp',
+            text: 'emails.password-otp-text',
+            with: ['resetUrl' => $this->resetUrl()],
+        );
+    }
+
+    /**
+     * Button target: the "enter your code" page with the email already filled in.
+     * The code itself is never put in a link (links end up in logs, scanners and previews).
+     */
+    private function resetUrl(): ?string
+    {
+        if (!$this->email) {
+            return null;
+        }
+
+        return rtrim((string) config('app.frontend_url'), '/')
+            . '/reset-password?'
+            . http_build_query(['email' => $this->email]);
     }
 }
